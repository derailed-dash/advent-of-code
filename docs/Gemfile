# Gemfile for GitHub Pages local Jekyll previews
# Compatible versions: https://pages.github.com/versions/
source "https://rubygems.org"

gem "github-pages", "~> 233", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-redirect-from"
  gem "jekyll-sitemap"
end

# Standard-library gems unbundled in Ruby 3.0-3.3+ required by Jekyll 3.10
gem "webrick", "~> 1.8"
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
